# ==============================================================================
# ATONIA AGENT - ENTERPRISE MULTI-TENANT CUSTOMER OPERATIONS HUB
# ENVIRONMENT CONFIGURATION SPECIFICATION (.env.example)
# ==============================================================================
# Safe placeholder template. Do NOT write real secrets into this file.
# Copy this file to .env and provide your deployment-specific credentials.

# ------------------------------------------------------------------------------
# 1. CORE SERVER & PLATFORM RUNTIME
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV="development"
APP_PORT=3000

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="your-gemini-api-key"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://your-domain.example.com"

# ------------------------------------------------------------------------------
# 2. PERSISTENCE LAYER (MONGODB ATLAS)
# ------------------------------------------------------------------------------
# MongoDB connection URI (e.g., mongodb+srv://<user>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority)
# Required in production mode. If omitted in development mode, the applet will run
# in [DEVELOPMENT-ONLY IN-MEMORY FALLBACK] mode with explicit warnings.
MONGODB_URI="mongodb+srv://<username>:<password>@cluster.atonia.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="atonia_agent"

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION SECRETS
# ------------------------------------------------------------------------------
# Cryptographic secret for signing session state and cookies (min 32 random characters)
SESSION_SECRET="replace-with-a-cryptographically-secure-random-session-secret"

# Cryptographic secret for signing HMAC JWT operator tokens (min 32 random characters)
JWT_SECRET="replace-with-a-cryptographically-secure-random-jwt-secret"

# ------------------------------------------------------------------------------
# 4. EXTERNAL INTEGRATIONS (SERVICE READINESS BOUNDARIES)
# ------------------------------------------------------------------------------
# Integrations without configured credentials will be accurately reported as
# 'not_configured' in governance matrices. Unconfigured credentials will not crash
# the application during startup.

# [Domain 1: Atonia Marketplace]
AMAZON_SP_API_CLIENT_ID="amzn-sp-api-client-id-placeholder"
AMAZON_SP_API_CLIENT_SECRET="amzn-sp-api-client-secret-placeholder"
SHIPSTATION_API_KEY="shipstation-api-key-placeholder"

# [Domain 2: Atonia Insurance Brokers Limited]
ACTURIS_BMS_API_KEY="acturis-bms-api-key-placeholder"
DVLA_REGISTRY_API_KEY="dvla-vehicle-registry-api-key-placeholder"
UNDERWRITING_CORE_ENDPOINT="https://underwriting.internal.atonia.com"

# [Domain 3: Eureka Banking]
OPENBANKING_CLIENT_ID="openbanking-client-id-placeholder"
OPENBANKING_CLIENT_SECRET="openbanking-client-secret-placeholder"
PLAID_CLIENT_ID="plaid-client-id-placeholder"
PLAID_SECRET="plaid-secret-placeholder"
FRAUD_SENTINEL_GATEWAY_KEY="fraud-sentinel-gateway-key-placeholder"

# [Domain 4: Sorplos Partnering Insurtech Limited]
CARRIER_AGGREGATOR_SECRET="carrier-aggregator-secret-placeholder"
STRIPE_SECRET_KEY="sk_test_placeholder"
NIN_BVN_VERIFY_ENDPOINT="https://identity.registry.verify.placeholder"

# [Shared: Telephony Voice Gateway]
SIP_TRUNK_URI="sip:trunk.atonia.internal:5060"
SIP_AUTH_USER="sip-agent-user-placeholder"
SIP_AUTH_PASSWORD="sip-agent-password-placeholder"
