# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Application Server Runtime
PORT=3000
NODE_ENV="development"

# MongoDB Database Connection
MONGODB_URI="mongodb://localhost:27017/atonia_agent"
MONGODB_DB_NAME="atonia_agent"

# Security & Authentication
SESSION_SECRET="your-secure-session-secret-atonia"
JWT_SECRET="your-jwt-secret-key-atonia"

# External Integrations (Service Boundaries)
# Marketplace (Atonia Marketplace)
AMAZON_SP_API_CLIENT_ID="amzn-sp-api-client-id"
AMAZON_SP_API_CLIENT_SECRET="amzn-sp-api-client-secret"
SHIPSTATION_API_KEY="shipstation-api-key"

# Insurance & Underwriting (Atonia Insurance)
ACTURIS_BMS_API_KEY="acturis-bms-api-key"
DVLA_REGISTRY_API_KEY="dvla-vehicle-registry-api-key"
UNDERWRITING_CORE_ENDPOINT="https://underwriting.internal.atonia.com"

# Banking & Risk Gateways (Eureka Banking)
OPENBANKING_CLIENT_ID="openbanking-client-id"
OPENBANKING_CLIENT_SECRET="openbanking-client-secret"
PLAID_CLIENT_ID="plaid-client-id"
PLAID_SECRET="plaid-secret-key"
FRAUD_SENTINEL_GATEWAY_KEY="fraud-sentinel-key"

# Insurtech Aggregator (Sorplos)
CARRIER_AGGREGATOR_SECRET="carrier-aggregator-key"
STRIPE_SECRET_KEY="sk_test_stripe_key"
NIN_BVN_VERIFY_ENDPOINT="https://identity.registry.verify"

# Telephony (Voice Agent)
SIP_TRUNK_URI="sip:trunk.atonia.internal:5060"
SIP_AUTH_USER="sip-agent-user"
SIP_AUTH_PASSWORD="sip-agent-password"
